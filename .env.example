# Cairn Environment Variables
# Copy this file to .env and fill in your values.

# Deployer private key (use a throwaway testnet key, never a mainnet key)
DEPLOYER_PRIVATE_KEY=

# Monad Testnet RPC URL
MONAD_RPC_URL=

# Relayer private key (separate from deployer, pays gas for judge mode)
RELAYER_PRIVATE_KEY=

# LLM provider for the attester (e.g. openai, anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
